# Copia este archivo como .env y completa los valores
# Puerto (Render/Railway lo asignan automaticamente)
PORT=3000

# Clave del panel /admin (operador). Cada artista NO usa esta clave: entra a
# /artista con un codigo personal de 6 digitos que se genera al crearlo desde /admin.
ADMIN_KEY=vertigo-admin

# MongoDB Atlas (tier gratis M0). Recomendado / practicamente obligatorio:
# los perfiles de artista y su repertorio deben sobrevivir entre visitas, y sin
# esto se pierden cada vez que el servidor se reinicia o se vuelve a desplegar.
# MONGODB_URI=mongodb+srv://usuario:pass@cluster.xxxxx.mongodb.net/vertigo?retryWrites=true&w=majority
