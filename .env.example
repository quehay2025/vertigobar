# Copia este archivo como .env y completa los valores
# Puerto (Render/Railway lo asignan automaticamente)
PORT=3000

# Clave del panel /admin (operador)
ADMIN_KEY=vertigo-admin

# Clave del panel /artista (comediante / DJ / artista)
ARTIST_KEY=vertigo-artista

# MongoDB Atlas (tier gratis M0). Si se deja vacio, corre en memoria.
# MONGODB_URI=mongodb+srv://usuario:pass@cluster.xxxxx.mongodb.net/vertigo?retryWrites=true&w=majority
