# Copia este archivo como .env y completa los valores
# Puerto (Render/Railway lo asignan automaticamente)
PORT=3000

# Clave del panel /admin (operador). Cada artista NO usa esta clave: entra a
# /artista con un codigo personal de 6 digitos que se genera al crearlo desde /admin.
ADMIN_KEY=tribu-admin

# MongoDB Atlas (tier gratis M0). Recomendado / practicamente obligatorio:
# los perfiles de artista y su repertorio deben sobrevivir entre visitas, y sin
# esto se pierden cada vez que el servidor se reinicia o se vuelve a desplegar.
# MONGODB_URI=mongodb+srv://usuario:pass@cluster.xxxxx.mongodb.net/tribu?retryWrites=true&w=majority

# --- La mesa reina (lectura de consumo por mesa desde la app KI, solo lectura) ---
# La API de KI debe responder: { "mesas": [ { "mesa": "12", "total": 134.5 }, ... ] }
# (solo mesa y total de la noche; nada de clientes ni datos de pago). Debe ser https.
# KI_API_URL=https://api.ki.example/v1/mesas-consumo
# KI_API_KEY=llave-solo-lectura-de-ki
# Cada cuántos ms se consulta (mínimo 10000, por defecto 30000)
# MESAS_POLL_MS=30000
# Firma de los enlaces/QR de mesa. Cámbiala y se invalidan los QR impresos.
# MESA_SECRET=una-frase-larga-y-secreta
# Dominio público para los enlaces de mesa
# PUBLIC_BASE_URL=https://arcade.tribugastropub.com
# Sin KI aún: MESAS_MOCK=1 muestra mesas simuladas para probar la pantalla
# MESAS_MOCK=1
# Dominios web permitidos para conectarse al tiempo real (además del propio sitio)
# ALLOWED_ORIGINS=https://arcade.tribugastropub.com,https://tribugastropub.com
